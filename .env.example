# Application
APP_ENV=development
APP_NAME=developer-profile-platform
APP_DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_DB=developer_platform
POSTGRES_USER=developer
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL
DATABASE_URL=postgresql+psycopg://developer:change_me@postgres:5432/developer_platform

# Authentication
SESSION_SECRET=change_me
SESSION_COOKIE_NAME=developer_session

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/integrations/github/callback

# Object Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=developer-platform
S3_REGION=us-east-1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000