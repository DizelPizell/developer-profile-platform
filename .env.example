# Application
APP_ENV=development
APP_NAME=developer-profile-platform

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_DB=developer_platform
POSTGRES_USER=developer
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL
DATABASE_URL=postgresql+psycopg://developer:change_me@postgres:5432/developer_platform

# Authentication
SESSION_COOKIE_NAME=developer_session
SESSION_TTL_DAYS=14

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# GitHub API (ADR-016, ADR-018). Public repository data is read with the same
# GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET, in a Basic header; no user token.
# GitHub requests one user may spend in any 60 minutes (a link up to 7, an import
# up to 6, a repository list page 1, a manual sync 7). At least 7.
GITHUB_USER_REQUESTS_PER_HOUR=60
# Seconds a page of the repository list is kept in the backend's memory, so
# reopening the import screen costs no GitHub requests. At least 1.
GITHUB_REPOSITORY_LIST_CACHE_SECONDS=300
# Seconds after a repository's latest sync job before a manual sync of it is
# allowed again (shared by every project that links it). At least 1.
GITHUB_MANUAL_SYNC_COOLDOWN_SECONDS=600
# The sync worker (ADR-009, ADR-018): seconds between polls of the job queue,
# attempts of one job, the retry delay that doubles from base up to max, and the
# seconds after which a SYNCING job is taken back from a lost worker. The
# github-worker service in Compose reads this file too, and needs no variable of
# its own.
GITHUB_WORKER_POLL_SECONDS=5
GITHUB_WORKER_MAX_ATTEMPTS=5
GITHUB_WORKER_RETRY_BASE_SECONDS=30
GITHUB_WORKER_RETRY_MAX_SECONDS=1800
GITHUB_WORKER_STALE_SECONDS=600
# The worker claims no job while GitHub's remaining budget is at or below this,
# leaving it to developers who are linking repositories.
GITHUB_WORKER_RESERVE=500

# A repository linked to a published project is synced this often; the worker
# queues at most this many such jobs a minute, so a manual sync never waits long.
GITHUB_PERIODIC_SYNC_SECONDS=86400
GITHUB_PERIODIC_SYNC_BATCH=30
FRONTEND_URL=http://localhost:3000

# Object Storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=developer-platform
S3_REGION=us-east-1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000