# Copy to .env.local. Both values are the API base address without /api/v1 (ADR-014).

# Used by code in the browser; inlined into the bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Used by server-side code. Inside Docker it names the backend service
# (for example http://backend:8000); outside Docker it equals the value above.
API_INTERNAL_URL=http://localhost:8000
